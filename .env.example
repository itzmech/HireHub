[TEMPLATE]
# Job Portal backend environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.

# Server port
PORT=3000

# JWT signing secret — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT time-to-live
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed frontend origins (production)
# Example: CORS_ORIGINS=https://jobs.example.com
CORS_ORIGINS=

# --- Vercel serverless deployment (optional) ------------------------------
# Set in Vercel: Project Settings -> Environment Variables.
#   JWT_SECRET                  required (falls back to per-instance ephemeral)
#   ADMIN_PASSWORD              seeds the demo admin on cold boot (idempotent);
#                               email defaults to admin@demo.com
#   ADMIN_EMAIL                 optional override for the seeded admin email
#   SEED_DEMO_JOBS=1            populates sample job listings on an empty database
#   DB_PATH                     do NOT set on Vercel (uses writable /tmp)

# Initial admin credentials for local `npm run seed` (and Vercel cold-boot seed)
ADMIN_NAME=Portal Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
