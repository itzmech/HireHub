# Job Portal backend environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.

# Server port
PORT=3000

# JWT signing secret — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT time-to-live
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed frontend origins (production)
# Example: CORS_ORIGINS=https://jobs.example.com
CORS_ORIGINS=

# SQLite database file location (optional; default: backend/database/jobportal.db)
# DB_PATH=/var/data/jobportal.db

# Initial admin seed credentials (used by `npm run seed` only)
ADMIN_NAME=Portal Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
